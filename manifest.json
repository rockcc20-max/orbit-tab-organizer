{
  "manifest_version": 3,
  "name": "Orbit - Tab Organizer",
  "description": "按网站汇总所有 Chrome 选项卡，并快速查找、切换和清理重复页面。",
  "version": "0.5.0",
  "icons": {
    "128": "assets/orbit-icon.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Orbit · 选项卡总览",
    "default_icon": "assets/orbit-icon.png"
  },
  "commands": {
    "open-orbit": {
      "suggested_key": {
        "default": "Ctrl+Shift+0",
        "mac": "Command+Shift+0"
      },
      "description": "Open Orbit tab organizer"
    }
  }
}
